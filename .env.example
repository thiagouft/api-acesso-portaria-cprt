# -----------------------------------------------------------------------------
# Exemplo de arquivo de configuração de variáveis de ambiente (.env)
# Copie este arquivo para um novo arquivo chamado ".env" na mesma pasta
# e substitua os valores pelos de desenvolvimento/produção reais.
# -----------------------------------------------------------------------------

# URL de conexão com o banco de dados SQL Server do Prisma
# Exemplo local: sqlserver://localhost:1433;database=meu_banco;user=sa;password=minha_senha;
DATABASE_URL="sqlserver://127.0.0.1:1433;database=acesso_portarias_cprt;user=sa;password=SuaSenhaAqui;encrypt=true;trustServerCertificate=true;"

# Chave secreta de segurança para assinatura dos tokens JWT da API
JWT_SECRET="sua_chave_secreta_para_tokens_jwt"

# Credenciais de autenticação no portal Dimep (para o script de sincronização automatizado)
AUTOSYNC_USER="usuario_acesso_dimep"
AUTOSYNC_PASS="senha_acesso_dimep"
